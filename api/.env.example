# Copiá este archivo a .env y completá los valores (en Render: Environment)
MONGO_URI=
PORT=5000
JWT_SECRET=            # cadena aleatoria larga: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ALEGRA_EMAIL=
ALEGRA_TOKEN=
CCR_API_URL=
CCR_USUARIO=
CCR_PASSWORD=
CCR_CODIGO_CLIENTE=
CCR_CODIGO_SERVICIO=
# Solo para seedSuperUser.js
# SEED_SUPERUSER_NAME=JuanPa
# SEED_SUPERUSER_PASSWORD=
# 🧾 Días que se guardan los pedidos Entregados/Cancelados antes de borrarse solos (por defecto 60)
PEDIDOS_RETENCION_DIAS=60
# 🧾 Usuarios (además del súper admin) que pueden cerrar el pedido semanal y marcar que llegó
PEDIDOS_CIERRE_USUARIOS=johanna,johana
CONTRAPEDIDOS_USUARIOS=johanna,johana
# 💳 Tilopay (checkout de la tienda online). Admin · Tilopay Checkout → credenciales de API
TILOPAY_API_KEY=
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
# TILOPAY_BASE_URL=https://app.tilopay.com/api/v1
# ✉️ Correo saliente (guía de Correos al cliente desde Ventas web). Gmail: contraseña de aplicación
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=ChemaSport ER <ventas@chemasporter.com>
# SMTP_REPLY_TO=ChemaSport__ER@outlook.com
# 🔔 A quién avisar de cada venta web (por defecto ChemaSport__ER@outlook.com)
# AVISO_VENTAS_CORREO=ChemaSport__ER@outlook.com
