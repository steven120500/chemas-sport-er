# Copiá este archivo a .env y completá los valores (en Render: Environment)
MONGO_URI=
PORT=5000
JWT_SECRET=            # cadena aleatoria larga: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ALEGRA_EMAIL=
ALEGRA_TOKEN=
CCR_API_URL=
CCR_USUARIO=
CCR_PASSWORD=
CCR_CODIGO_CLIENTE=
CCR_CODIGO_SERVICIO=
# Solo para seedSuperUser.js
# SEED_SUPERUSER_NAME=JuanPa
# SEED_SUPERUSER_PASSWORD=
# 🧾 Días que se guardan los pedidos Entregados/Cancelados antes de borrarse solos (por defecto 60)
PEDIDOS_RETENCION_DIAS=60
# 🧾 Usuarios (además del súper admin) que pueden cerrar el pedido semanal y marcar que llegó
PEDIDOS_CIERRE_USUARIOS=johanna,johana
